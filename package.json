{
  "name": "@fringeworks/web-utils",
  "version": "1.0.0",
  "private": true,
  "description": "A library some will find handy, providing utilities for the web.",
  "keywords": [
    "browser",
    "utils"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fringeworks-js/web-utils.git"
  },
  "license": "MIT",
  "author": "Mitsuhiro Seino",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*/index.ts"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "indexes": "tsx scripts/indexes.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "release": "pnpm build && npm publish ./dist",
    "test": "vitest --project unit --project browser",
    "test:browsers": "vitest run --project unit --project all-browsers --coverage.enabled=false",
    "tidy": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\" --config ./prettier.tidy.config.ts"
  },
  "dependencies": {
    "@fringeworks/types": "^1.3.0"
  },
  "devDependencies": {
    "@fringeworks/dev": "^0.14.0",
    "@types/node": "^25.9.9",
    "@vitest/browser-playwright": "^4.1.12",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.14.0",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@12.21.0"
}
